<% content_for :title, "Dashboard sync" %>

<div class="admin-user-show">
  <h1 class="admin-user-show__title">External dashboard sync</h1>

  <div class="admin-user-show__grid">
    <div class="mission-panel">
      <h2 class="admin-user-show__section-title">Fleet</h2>
      <dl class="admin-user-show__dl">
        <dt>Total certs</dt>          <dd><%= @stats[:total] %></dd>
        <dt>On dashboard</dt>         <dd><%= @stats[:synced] %></dd>
        <dt>Not on dashboard</dt>     <dd><%= @stats[:unsynced] %></dd>
        <dt>Eligible for backfill</dt><dd><%= @stats[:eligible] %></dd>
        <dt>Hardware (never syncs)</dt><dd><%= @stats[:unsynced_hardware] %></dd>
        <dt>Deleted projects</dt>     <dd><%= @stats[:unsynced_deleted] %></dd>
        <dt>Active YSWS returns</dt>  <dd><%= @stats[:unsynced_active_returns] %> <span class="admin-user-show__muted">(synced via their approved cert)</span></dd>
        <dt>Synced, last 24h</dt>     <dd><%= @stats[:synced_recently] %></dd>
        <dt>Failed, last 24h</dt>     <dd><%= @stats[:failed_recently] %></dd>
      </dl>
    </div>

    <div class="mission-panel">
      <h2 class="admin-user-show__section-title">Latest run</h2>
      <% if @report %>
        <dl class="admin-user-show__dl">
          <dt>Run</dt>           <dd><%= @report[:run_id] %></dd>
          <dt>Enqueued</dt>      <dd><%= @report[:enqueued] %></dd>
          <dt>OK</dt>            <dd><%= @report[:ok] %></dd>
          <dt>Duplicates</dt>    <dd><%= @report[:duplicate] %></dd>
          <dt>Skipped</dt>       <dd><%= @report[:skipped] %></dd>
          <dt>Failed</dt>        <dd><%= @report[:failed] %></dd>
          <dt>Jobs in flight</dt><dd><%= @in_flight || "—" %></dd>
        </dl>
        <p class="admin-user-show__muted">
          OK is derived (enqueued minus the rest) and is only exact once jobs in flight hits 0.
          In flight counts live pushes too and excludes failed jobs parked for retry. Refresh to update.
        </p>
      <% else %>
        <p class="admin-user-show__muted">No run recorded in the last 7 days.</p>
      <% end %>

      <h2 class="admin-user-show__section-title">Actions</h2>
      <%= button_to "Run backfill", admin_certification_backfill_path, method: :post,
            class: "action-btn action-btn--small action-btn--primary",
            form: { data: { turbo_confirm: "Queue a push for every eligible unsynced cert?" } } %>
      <p class="admin-user-show__muted">
        Pushes every eligible cert above. Rate-limited, idempotent, safe to re-run.
      </p>
      <%= form_with url: wipe_uuids_admin_certification_backfill_path, method: :post,
            data: { turbo_confirm: "Wipe ALL dashboard UUIDs from every cert? There is no local undo." } do |f| %>
        <%= f.text_field :confirmation, placeholder: "type WIPE to confirm", autocomplete: "off" %>
        <%= f.submit "Wipe all UUIDs", class: "action-btn action-btn--small action-btn--destructive" %>
      <% end %>
      <p class="admin-user-show__muted">
        Clears every stored UUID. Only for a full resync, and only after the dashboard side is wiped first:
        against a live dashboard, re-pushes 409 and heal the same UUIDs back.
      </p>
    </div>
  </div>

  <div class="mission-panel">
    <h2 class="admin-user-show__section-title">Sync log</h2>
    <dl class="admin-user-show__dl">
      <% @sync_log.each do |cert| %>
        <% deleted = cert.project.nil? || cert.project.deleted_at.present? %>
        <dt>
          <%= link_to "Cert ##{cert.id}", admin_certification_ship_path(cert) %>
          <span class="status-pill status-pill--<%= cert.status %>"><%= cert.status.capitalize %></span>
        </dt>
        <dd>
          <%= cert.project&.title || "(no project)" %>
          <% if deleted %>
            <span class="admin-user-show__muted">(deleted project)</span>
          <% end %>
          <% if cert.pending? && cert.returned_by_id.present? %>
            <span class="admin-user-show__muted">(active YSWS return)</span>
          <% elsif cert.project&.hardware? %>
            <span class="admin-user-show__muted">(hardware)</span>
          <% end %>
          <br>
          <% if cert.external_certification_id.present? %>
            On dashboard:
            <%= link_to "open ↗", ExternalDashboard::Client.certification_url(cert.external_certification_id),
                  target: "_blank", rel: "noopener noreferrer" %>
            <% if cert.external_sync_attempted_at.present? %>
              <span class="admin-user-show__muted">(last sync <%= time_ago_in_words(cert.external_sync_attempted_at) %> ago)</span>
            <% end %>
            <% if cert.external_sync_error.present? %>
              <br><%= cert.external_sync_error %>
            <% end %>
          <% elsif cert.external_sync_error.present? %>
            <%= cert.external_sync_error %>
            <span class="admin-user-show__muted">(<%= time_ago_in_words(cert.external_sync_attempted_at) %> ago)</span>
          <% elsif cert.external_sync_attempted_at.present? %>
            Attempted <%= time_ago_in_words(cert.external_sync_attempted_at) %> ago, no error recorded.
          <% else %>
            Never attempted.
          <% end %>
        </dd>
      <% end %>
    </dl>
    <% if @pagy.pages > 1 %>
      <%== @pagy.series_nav %>
    <% end %>
  </div>
</div>
